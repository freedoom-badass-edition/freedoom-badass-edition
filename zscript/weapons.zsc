		Weapon.AmmoUse 1;
		Weapon.AmmoGive 20;
		Weapon.AmmoType "Clip";
		Tag "Spanish Pistol";
	}
	States
	{
	Ready:
		PSSG A 1 A_WeaponReady;
		Loop;
	Deselect:
		PSSG A 1 A_Lower(18);
		Loop;
	Select:
		PSSG A 1 A_Raise(18);
		Loop;
	Fire:
		PSSG A 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
		PSSG B 3
		{
		   A_FireBullets (4, 2, 1, random(16,32), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
		   A_StartSound("weapons/spanishpistol", CHAN_WEAPON, CHANF_DEFAULT, 1.0, ATTN_NORM, 0.75);
		   A_GunFlash();
		}
		PSSG B 2
		{
		   A_FireBullets (4, 2, 1, random(16,32), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
		   A_StartSound("weapons/spanishpistol", CHAN_AUTO, CHANF_DEFAULT, 0.5, ATTN_NORM, 0.75);
		   A_GunFlash();
		}
		PSSG C 4;
		PSSG B 4 A_ReFire;
		Goto Ready;
	FireCocaine:
		PSSG B 3
		{
		   A_FireBullets (4, 2, 5, random(64,128), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
		   A_StartSound("weapons/spanishpistol", CHAN_WEAPON, CHANF_DEFAULT, 1.0, ATTN_NORM, 0.75);
		   A_GunFlash();
		}
		PSSG B 2
		{
		   A_FireBullets (4, 2, 5, random(64,128), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
		   A_StartSound("weapons/spanishpistol", CHAN_AUTO, CHANF_DEFAULT, 0.5, ATTN_NORM, 0.75);
		   A_GunFlash();
		}
		PSSG C 3;
		PSSG B 3 A_ReFire;
		Goto Ready;
	AltFire:
		PFSG B 0 A_JumpIfInventory("CocainePower", 1, "AltFireCocaine");
		PFSG A 0 A_WeaponOffset(0.0, 32.0);
		PFSG A 2 A_StartSound("skeleton/swing");
		PFSG AA 2 A_WeaponOffset(-64.0, 2.0, WOF_ADD);
		PFSG A 0 A_CustomPunch(random(10,15), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
		PFSG AAA 2 A_WeaponOffset(-64.0, 24.0, WOF_ADD);
		PFSG A 2 A_ReFire;
		Goto Ready;
	AltFireCocaine:
		PFSG A 0 A_WeaponOffset(0.0, 32.0);
		PFSG A 1 A_StartSound("skeleton/swing");
		PFSG AA 1 A_WeaponOffset(-64.0, 2.0, WOF_ADD);
		PFSG A 0 A_CustomPunch(random(100,150), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
		PFSG AAA 1 A_WeaponOffset(-64.0, 24.0, WOF_ADD);
		PFSG A 1 A_ReFire;
		Goto Ready;
	Flash:
		PSSF A 2 Bright A_Light1;
		Goto LightDone;
		TNT1 A 1;
		PSSF A 2 Bright A_Light1;
		Goto LightDone;
 	Spawn:
		PSST A -1;
		Stop;
	}
}

