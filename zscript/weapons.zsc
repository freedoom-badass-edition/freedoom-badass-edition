CLASS DumbassShitFuckDickCockShotgun : Shotgun replaces Shotgun { 
	Default {
		Weapon.SelectionOrder 1300;
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 8;
		Weapon.AmmoType "Shell";
		Weapon.AmmoType2 "Shell";
		Inventory.PickupMessage "$GOTDSFDCSHOTGUN";
		Obituary "$OB_DSFDCSHOTGUN";
		Tag "$TAG_DSFDCSHOTGUN";
	}
	States
	{
		Ready:
			SHTG A 1 A_WeaponReady;
			Loop;
		Deselect:
			SHTG A 1 A_Lower(18);
			Loop;
		Select:
			SHTG A 1 A_Raise(18);
			Loop;
		Fire:
			SHTG A 0 A_JumpIfInventory("SpanishFist", 1, "FireSailor");
			SHTG A 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
			SHTS A 0
			{
			    A_Quake(1,4,0,100);
			    A_FireBullets(100, 100, 1000, random(1,5), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(80);
			}
			SHTS A 1 A_SetPitch(pitch-5);
			SHTS AAAB 1 A_SetPitch(pitch+1);
			SHTS B 0
			{
			    A_Quake(1,4,0,100);
			    A_FireBullets(50, 50, 500, 2, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(40);
			}
			SHTS B 1 A_SetPitch(pitch-5);
			SHTS BBCC 1 A_SetPitch(pitch+1);
			SHTS C 0
			{
			    A_FireBullets(10, 10, 100, 2, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			}
			SHTS C 4;
			SHTS ABCABCABC 4;
			SHTG B 3 A_StartSound("DSCOCKA", CHAN_WEAPON);
			SHTG C 3;
			SHTG D 3 A_StartSound("DSCOCKB", CHAN_WEAPON);
			SHTG CB 3;
			SHTG A 7 A_ReFire;
			Goto Ready;
		FireCocaine:
			SHTS A 0
			{
			    A_Quake(1,4,0,100);
			    A_FireBullets(100, 100, 1000, random(1,2), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(80);
			}
			SHTS A 1 A_SetPitch(pitch-5);
			SHTS AAAB 1 A_SetPitch(pitch+1);
			SHTS B 0
			{
			    A_Quake(1,4,0,100);
			    A_FireBullets(50, 50, 500, 1, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(40);
			}
			SHTS B 1 A_SetPitch(pitch-5);
			SHTS BBCC 1 A_SetPitch(pitch+1);
			SHTS C 0
			{
			    A_FireBullets(10, 10, 100, 1, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			}
			SHTS C 2;
			SHTS A 5;
			SHTG B 2 A_StartSound("DSCOCKA", CHAN_WEAPON);
			SHTG C 2;
			SHTG D 2 A_StartSound("DSCOCKB", CHAN_WEAPON);
			SHTG CB 2;
			SHTG A 4 A_ReFire;
			Goto Ready;
		FireSailor:
			SHTG A 0 A_JumpIfInventory("CocainePower", 1, "FireSailorCocaine");
			SHTG A 2
			{
			  A_FireBullets (5.6,5.6,10,random(7,11),"BulletPuff",FBF_USEAMMO|FBF_NORANDOM);
			  A_StartSound("weapons/autoshotgun", CHAN_WEAPON);
			  A_GunFlash();
			  A_WeaponOffset(0.0, 48.0, WOF_INTERPOLATE);
			  A_Recoil(5);
			}
			SHTG A 2 A_WeaponOffset(0.0, 44.0, WOF_INTERPOLATE);
			SHTG A 2 A_WeaponOffset(0.0, 36.0, WOF_INTERPOLATE);
			SHTG A 2 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			Goto Ready;
		FireSailorCocaine:
			SHTG A 2
			{
			  A_FireBullets (5.6,5.6,20,random(21,33),"BulletPuff",FBF_USEAMMO|FBF_NORANDOM);
			  A_StartSound("weapons/m3", CHAN_WEAPON);
			  A_GunFlash();
			  A_WeaponOffset(0.0, 56.0, WOF_INTERPOLATE);
			  A_Recoil(10);
			}
			SHTG A 2 A_WeaponOffset(0.0, 52.0, WOF_INTERPOLATE);
			SHTG A 2 A_WeaponOffset(0.0, 36.0, WOF_INTERPOLATE);
			SHTG A 2 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			Goto Ready;
		Flash:
			SHTF B 1 Bright A_Light2;
			SHTF A 1 Bright A_Light1;
			Goto LightDone;
		AltFlash:
			SHTF B 1 Bright A_Light2;
			SHTF A 1 Bright A_Light1;
			Goto LightDone;
		Spawn:
			SHOT A -1;
			Stop;
	}
}

CLASS SmallButPackingChaingun : Chaingun replaces Chaingun { 
	Default {
		Weapon.BobRangeX 0.75;
		Weapon.BobRangeY 0.25;
		Weapon.BobSpeed 0.75 ;
		Weapon.KickBack 1000;
		Weapon.SelectionOrder 700;
		Weapon.AmmoUse 5;
		Weapon.AmmoGive 100;
		Weapon.AmmoType "Clip";
		Inventory.PickupMessage "$GOTOVERCHARGEDMINIGUN";
		Obituary "$OB_OVERCHARGEDMINIGUN";
		Tag "$TAG_OVERCHARGEDMINIGUN";
	}
	States
	{
		Ready:
			CHGG A 1 A_WeaponReady;
			Loop;
		Deselect:
			CHGG A 1 A_Lower(18);
			Loop;
		Select:
			CHGG A 1 A_Raise(18);
			Loop;
		Fire:
			CHGG A 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
			TNT1 A 0 A_GunFlash;
			CHGG AB 2
			{
			    A_FireBullets(7, 2.8, 10, random(20,30), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_Recoil(2);
			    A_StartSound("weapons/m249", CHAN_WEAPON);
			}
			CHGG ABABABAB 2 A_ReFire;
			CHGG ABAB 4 A_ReFire;
			CHGG AB 6;
			Goto Ready;
		FireCocaine: 
			TNT1 A 0 A_GunFlash("FlashCocaine");
			CHGG AB 1
			{
			    A_FireBullets(10, 4, 20, random(50,200), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_Recoil(4);
			    A_StartSound("weapons/m249", CHAN_WEAPON);
			}
			CHGG ABABABAB 1 A_ReFire;
			CHGG ABAB 2 A_ReFire;
			CHGG AB 3;
			Goto Ready;
		Flash:
			CHGF A 2 Bright A_Light1;
			CHGF B 2 Bright A_Light1;
			Goto LightDone;
		FlashCocaine:
			CHGF A 1 Bright A_Light1;
			CHGF B 1 Bright A_Light1;
			Goto LightDone;
		Spawn:
			MGUN A -1;
			Stop;
	}
}

CLASS SingularBullet : Weapon { 
	double angley;
	Default {
		Weapon.SelectionOrder 3700;
		Weapon.Kickback 100;
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 1;
		Weapon.AmmoType "Clip";
		Weapon.AmmoUse2 1;
		Weapon.AmmoType2 "Clip";
		Inventory.PickupMessage "$GOTSINGULARBULLET" ;
		Obituary "$OB_SINGULARBULLET";
		Tag "$TAG_SINGULARBULLET";
		+WEAPON.ALT_AMMO_OPTIONAL
		+weapon.wimpy_weapon
	}
	States
	{
		Ready: 
			PUNG A 1 A_WeaponReady;
			Loop;
		Deselect:
			PUNG A 1 A_Lower(18);
			Loop;
		Select:
			PUNG A 1 A_Raise(18);
			Loop;
		Fire:
			PUNG A 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
			BULP HIJABCD 1;
			BULP E 0
			{
			    A_StartSound("*fist", CHAN_AUTO);
			    A_StartSound("weapons/pistol", CHAN_WEAPON);
			}
			BULP E 2 A_FireBullets(0, 0, 1, random(20,50), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			BULP FG 1;
			PUNG A 1 A_ReFire;
			Goto Ready;
		FireCocaine:
			BULP HJB 1;
			BULP E 0
			{
			    A_StartSound("*fist", CHAN_AUTO);
			    A_StartSound("weapons/pistol", CHAN_WEAPON);
			}
			BULP E 1 A_FireBullets(1, 1, 3, random(50,200), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			BULP FG 1;
			PUNG A 1 A_ReFire;
			Goto Ready;
		AltFire:
			OIJG A 0 A_JumpIfInventory("CocainePower", 1, "AltFireCocaine");
			OIJG A 2 { A_StartSound("skeleton/swing"); invoker.angley = -6; }
			OIJG BBCC 1 {
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				
			}
			OIJG D 1 {
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				A_CustomPunch(random(5,15), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
			}
			OIJG D 1 {
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				if(countinv("clip"))A_FireProjectile("ThrownBullet",invoker.angley,true); invoker.angley++;
				
			}
			OIJG E 2;
			OIJG F 2 A_ReFire;
			Goto Ready;
		AltFireCocaine:
			OIJG A 1 { A_StartSound("skeleton/swing"); invoker.angley = -6; }
			OIJG BC 1 {
				for(int i = 1; i <= 4; i++) {
					if(countinv("clip"))A_FireProjectile("ThrownBulletCrack",invoker.angley,true); invoker.angley++;
				}
			}
			OIJG D 1 {
				for(int i = 1; i <= 4; i++) {
					if(countinv("clip"))A_FireProjectile("ThrownBulletCrack",invoker.angley,true); invoker.angley++;
				}
				A_CustomPunch(random(40,120), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
			}
			OIJG E 1;
			OIJG F 1 A_ReFire;
			Goto Ready;
		Spawn:
			BULL A -1;
			Loop;
	}
}

class ThrownBullet : actor {
	default {
		Radius 8;
		Height 8;
		Speed 52;
		DamageFunction (random(16,40));
		Projectile;
		scale 1.25;
		-NOGRAVITY
		+bounceonactors
		BounceType "Doom";
		bouncecount 16;
		DeathSound "weapons/pistol";
		BounceSound "weapons/pistol";
		Gravity 0.5;
		Obituary "$OB_SINGULARBULLET";
	}
	states {
		spawn:
			bull a 1;
			loop;
		death:
			puff a 2 bright;
			puff bcd 2;
			stop;
	}
}

class ThrownBulletCrack : ThrownBullet {
	default {
		damagefunction (random(32,96));
		scale 2;
	}
}

CLASS DuperShotgun : SuperShotgun replaces SuperShotgun { 
	Default {
		Weapon.SelectionOrder 400;
