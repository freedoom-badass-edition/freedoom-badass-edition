			    A_FireBullets (12, 7, 80, 150, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound ("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(160);
			}
			SHT2 A 1 A_SetPitch(pitch-40);
			SHT2 AAAAAA 1 A_SetPitch(pitch+6);
			SHT2 B 2;
			SHT2 C 2 A_CheckReload;
			SHT2 D 2 A_OpenShotgun2;
			SHT2 E 2;
			SHT2 F 2 A_LoadShotgun2;
			SHT2 DE 2;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 G 1;
			SHT2 H 2 A_CloseShotgun2;
			SHT2 A 3 A_ReFire;
			Goto Ready;
		AltFire:
			SHT2 A 0 A_JumpIfInventory("CocainePower", 1, "AltFireCocaine");
			SHT2 A 3;
			SHD2 EDCBA 3;
			SHD2 F 0
			{
			    A_Quake(8,12,0,1000);
			    A_FireBullets (32, 24, 80, 75, "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			    A_StartSound ("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(320);
			}
			SHD2 A 1 A_SetPitch(pitch-60);
			SHD2 AAFFFAAAAA 1 A_SetPitch(pitch+6);
			SHD2 A 7;
			SHD2 ABCDE 2;
			SHT2 AB 2;
			SHT2 C 7 A_CheckReload;
			SHT2 D 4 A_OpenShotgun2;
			SHT2 E 4;
			SHT2 F 4 A_LoadShotgun2;
			SHT2 DE 4;
			SHT2 F 4 A_LoadShotgun2;
			SHT2 DE 4;
			SHT2 F 4 A_LoadShotgun2;
			SHT2 DE 3;
			SHT2 F 3 A_LoadShotgun2;
			SHT2 DE 3;
			SHT2 F 3 A_LoadShotgun2;
			SHT2 DE 3;
			SHT2 F 3 A_LoadShotgun2;
			SHT2 DE 2;
			SHT2 F 2 A_LoadShotgun2;
			SHT2 DE 2;
			SHT2 F 2 A_LoadShotgun2;
			SHT2 DE 2;
			SHT2 F 2 A_LoadShotgun2;
			SHT2 DE 2;
			SHT2 F 2 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 G 6;
			SHT2 H 6 A_CloseShotgun2;
			SHT2 A 5 A_ReFire;
			Goto Ready;
		AltFireCocaine:
			SHT2 A 1;
			SHD2 EDCBA 1;
			SHD2 F 0
			{
			    A_Quake(8,12,0,1000);
			    A_FireBullets (32, 24, 160, 300, "BulletPuff");
			    A_StartSound ("weapons/sshotf", CHAN_WEAPON);
			    A_GunFlash();
			    A_Recoil(320);
			}
			SHD2 A 1 A_SetPitch(pitch-60);
			SHD2 AFAA 1 A_SetPitch(pitch+12);
			SHD2 A 1;
			SHD2 ABCDE 2;
			SHT2 AB 2;
			SHT2 C 1 A_CheckReload;
			SHT2 D 1 A_OpenShotgun2;
			SHT2 E 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 DE 1;
			SHT2 F 1 A_LoadShotgun2;
			SHT2 G 1;
			SHT2 H 2 A_CloseShotgun2;
			SHT2 A 3 A_ReFire;
			Goto Ready;
		Flash:
			SHT2 I 4 Bright A_Light1;
			SHT2 J 3 Bright A_Light2;
			Goto LightDone;
		AltFlash:
			SHE2 A 1 Bright A_Light1;
			SHE2 B 2 Bright A_Light2;
			Goto LightDone;	
		Spawn:
			SGN2 A -1;
			Stop;
	}
}

CLASS Cocaine : Berserk replaces Berserk { 
	Default {
		+COUNTITEM;
		+INVENTORY.ALWAYSPICKUP;
		Inventory.PickupMessage "$GOTCOCAINE";
		Inventory.PickupSound "cocaine/pickup";
		Tag "Cocaine";
	}
	States
	{
		Spawn:
			PSTR A -1;
			Stop;
		Pickup:
			TNT1 A 0 A_GiveInventory("CocainePower");
			TNT1 A 0 HealThing(150, 2500);
			Stop;
	}
}

CLASS CocainePower : Powerup { 
	Default {
		Powerup.Duration -90;
		Powerup.Color "255, 0, 128, 0.25";
		+INVENTORY.HUBPOWER;
	}
}

CLASS SawSaw : Chainsaw replaces Chainsaw { 
	//defined when the sawsaw sound starts
	int loops;
	Default {
		Weapon.Kickback -100;
		Weapon.SelectionOrder 2200;
		Weapon.UpSound "";
		Weapon.ReadySound "";
		Inventory.PickupMessage "$GOTSAWSAW";
		Obituary "$OB_SAWSAW";
		Tag "$TAG_SAWSAW";
		+WEAPON.MELEEWEAPON;
	}
	States
	{
		Ready:
			SAWG C 1 A_WeaponReady;
			Loop;
		Deselect:
			SAWG C 1 A_Lower(18);
			Loop;
		Select:
			SAWG C 1 A_Raise(18);
			Loop;
		Fire:
			SAWG C 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
			SAWG C 2
			{
				A_Saw("","",1);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 2;
			SAWG DCDCD 4;
			SAWG C 2;
			SAWG C 2
			{
				A_Saw("","",1);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 2;
			SAWG DCDCD 4;
			SAWG C 2;
			SAWG C 2
			{
				A_Saw("","",1);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 2;
			SAWG DCDCD 4;
			SAWG C 2;
			SAWG C 2
			{
				A_Saw("","",1);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDC 4;
			SAWG B 0
			{
				A_StartSound("DSSAWSAW", CHAN_AUTO, CHANF_OVERLAP);
				invoker.loops=125; //how many times to loop
			}
		Looper:
			SAWG A 1
			{
				A_Recoil(-5);
				A_Saw("","misc/gibbed",100);
			}
			SAWG B 1
			{
				A_Recoil(-5);
				A_Saw("","misc/gibbed",100);
			}
			SAWG B 0
			{
				if (--invoker.loops != 0)
				{
				return ResolveState("Looper");
				}
				A_ReFire();
				return ResolveState("Ready");
			}
		FireCocaine:
			SAWG C 1
			{
				A_Saw("","",5);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 1;
			SAWG C 1
			{
				A_Saw("","",5);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 1;
			SAWG C 1
			{
				A_Saw("","",5);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 1;
			SAWG C 1
			{
				A_Saw("","",5);
				A_StartSound("sawfail", CHAN_AUTO, CHANF_OVERLAP);
			}
			SAWG DCDCDC 1;
			SAWG B 0
			{
				A_StartSound("DSSAWSAW", CHAN_AUTO, CHANF_OVERLAP);
				invoker.loops=125; //how many times to loop
			}
			Goto Looper;
		Spawn:
			CSAW A -1;
			Stop;
	}
}

