CLASS BadassFist : Fist {
	default {
		+weapon.wimpy_weapon
	}
	States {
		select:
			pung a 1 a_raise(18);
			loop;
		deselect:
			pung a 1 a_lower(18);
			loop;
		Fire:
			OIJG A 0 A_JumpIfInventory("CocainePower", 1, "FireCocaine");
			OIJG A 2 A_StartSound("skeleton/swing");
			OIJG BC 2;
			OIJG D 2 A_CustomPunch(random(5,15), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
			OIJG E 2;
			OIJG F 2 A_ReFire;
			Goto Ready;
		FireCocaine:
			OIJG A 1 A_StartSound("skeleton/swing");
			OIJG BC 1;
			OIJG D 1 A_CustomPunch(random(40,120), false, 0, "BulletPuff", 70,0,0,"ArmorBonus","HOWCANSHESLAP");
			OIJG E 1;
			OIJG F 1 A_ReFire;
			Goto Ready;
		AltFire:
			ZOOM A 0 A_JumpIfInventory("CocainePower", 1, "AltFireCocaine");
			ZOOM A 0 A_WeaponOffset(0.0, 32.0);
			ZOOM A 26 A_StartSound("ZUMUPANCHI");
			ZOOM A 4 A_WeaponOffset(-80.0, -80.0, WOF_ADD|WOF_INTERPOLATE);
			ZOOM A 0 A_WeaponOffset(16.0, 16.0, WOF_ADD);
			ZOOM A 2 A_CustomPunch(random(25,75), false, 0, "BulletPuff", 200);
			ZOOM A 2 A_WeaponOffset(16.0, 16.0, WOF_ADD);
			ZOOM A 4 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			PUNG A 0 A_WeaponOffset(0.0, 64.0);
			PUNG A 4 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			PUNG A 4 A_ReFire;
			Goto Ready;
		AltFireCocaine:
			ZOOM A 0 A_WeaponOffset(0.0, 32.0);
			ZOOM A 1 A_StartSound("ZUMUPANCHIcocaine");
			ZOOM A 1 A_WeaponOffset(-80.0, -80.0, WOF_ADD|WOF_INTERPOLATE);
			ZOOM A 0 A_WeaponOffset(16.0, 16.0, WOF_ADD);
			ZOOM A 1 A_CustomPunch(random(150,350), false, 0, "BulletPuff", 300);
			ZOOM A 1 A_WeaponOffset(16.0, 16.0, WOF_ADD);
			ZOOM A 2 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			PUNG A 0 A_WeaponOffset(0.0, 64.0);
			PUNG A 2 A_WeaponOffset(0.0, 32.0, WOF_INTERPOLATE);
			PUNG A 2 A_ReFire;
			Goto Ready;
	}
}

